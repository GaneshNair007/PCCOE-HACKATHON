# Carbonerra AI Sidecar (Mission Control) Configuration
# Strict separation: Do not copy secrets to client or root files.

# Server configuration
SIDECAR_PORT=3002
ORIGINAL_APP_BASE_URL=http://localhost:3001

# AI Model Provider: "groq" (default), "gemini", "ollama", or "offline"
AI_PROVIDER=groq

# Groq Configuration (Free Tier: 30 req/min, 1,000 req/day, 8k TPM, 200k TPD)
# Recommended model: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Configuration (Optional secondary provider)
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Ollama Configuration (Optional local provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Resilience & Policy Settings
ALLOW_HOSTED_FALLBACK=true
KNOWLEDGE_VERSION=2026.1
PROMPT_VERSION=2026.1.0-mission-control
