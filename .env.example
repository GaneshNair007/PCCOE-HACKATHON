# ========================================================
# CARBONERRA DIGITAL SUSTAINABILITY ENGINE (.env.example)
# Real Data Only Architecture - Configuration Reference
# ========================================================

# [1. PRIMARY PERFORMANCE PROVIDERS]
# Optional: Google PageSpeed Insights v5 API Key (raises rate limits from 25k/day to enterprise)
# If omitted: Carbonerra runs the independent Cheerio static crawler fallback automatically.
PAGESPEED_API_KEY=

# [2. HOSTING & GRID CONTEXT PROVIDERS]
# Optional: The Green Web Foundation API Key (raises rate limits for greencheck & IP-to-CO2 intensity)
# If omitted: Uses public GWF API endpoints and falls back gracefully to global default (494 gCO2e/kWh).
GREEN_HOSTING_API_KEY=
GRID_INTENSITY_API_KEY=

# Optional: IP Geolocation API Key (e.g. ipinfo.io or maxmind)
# If omitted: Uses DNS lookup and reverse geocoding via public IP-API.
IP_GEOLOCATION_API_KEY=

# [3. AI ASSISTANT / CHATBOT]
# Optional: LLM provider for natural language queries (OpenRouter / Anthropic / OpenAI)
# If omitted: Chatbot executes server-side grounded deterministic tools (run_audit, compare, simulate, explain_for_exec).
OPENROUTER_API_KEY=

# [4. SECURITY & SSRF CONTROLS]
# Rate limiting threshold per IP (default: 30 requests per 60-second window)
AUDIT_RATE_LIMIT=30
AUDIT_RATE_LIMIT_WINDOW_MS=60000

# Concurrency & timeout controls
AUDIT_MAX_CONCURRENCY=5
AUDIT_TIMEOUT_MS=12000
AUDIT_MAX_REDIRECTS=5
AUDIT_MAX_CONTENT_LENGTH_BYTES=26214400 # 25 MB max per crawl probe

# [5. TESTING & DEMO MODE]
# Explicit hackathon demo mode (must be false in production)
# When true: clearly displays "Demo dataset — not live measurement" on synthetic fixtures.
DEMO_MODE=false

# [6. PRODUCTION DATABASE & REDIS QUEUE (OPTIONAL)]
# Optional: PostgreSQL connection URL (e.g. Supabase / Neon / RDS)
DATABASE_URL=

# Optional: Redis connection for distributed task queue and multi-instance caching
REDIS_URL=

# [7. SERVER CONFIGURATION]
PORT=3001
NODE_ENV=development
